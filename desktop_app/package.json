{
  "name": "ruby-desktop-agent",
  "author": "Syed-Haseeb97",
  "description": "Ruby agent desktop UI preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:electron": "node --test electron/*.test.cjs",
    "backend:build": "node scripts/build-backend.cjs",
    "smoke:backend:packaged": "node scripts/smoke-packaged-backend.cjs",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:pack": "npm run backend:build && npm run build && electron-builder --dir",
    "desktop:dist": "npm run backend:build && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "vite": "8.3.4",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.ruby.agentdesktop",
    "productName": "Ruby Agent",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json", "!electron/**/*.test.cjs"],
    "extraResources": [{ "from": "backend-dist/ruby-backend", "to": "backend", "filter": ["**/*"] }],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
