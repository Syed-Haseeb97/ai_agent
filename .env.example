# Get a free Gemini API key from https://aistudio.google.com/app/apikey
# No credit card required for the free tier.
GEMINI_API_KEY=your_gemini_api_key_here

# Ruby chat model (primary) and comma-separated request-time fallbacks.
# Override the primary model here without changing code.
RUBY_GEMINI_MODEL=gemini-2.5-flash
RUBY_GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-flash-latest
